{
  "ConnectionStrings": {
    "DefaultConnection": "Server=LAPTOP-UP2SHPTC;Database=VinhHyAudioTourDB;User Id=sa;Password=123456;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Secret": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "VinhHy.NarrationAPI",
    "Audience": "VinhHy.NarrationAPI.Clients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "PoiRegistrationPayment": {
    "DefaultFeeAmount": 200000,
    "Currency": "VND",
    "Provider": "SimulatedMoMo"
  },
  "PoiActivation": {
    "ValidityDays": 365
  },
  "Translation": {
    "Provider": "Simulated",
    "GoogleTranslate": {
      "ApiKeyEnvironmentVariable": "GOOGLE_TRANSLATE_API_KEY",
      "TimeoutSeconds": 30
    }
  },
  "MediaUpload": {
    "MaxImageFileSizeBytes": 5242880,
    "MaxAudioFileSizeBytes": 52428800
  },
  "PublicWeb": {
    "BaseUrl": "http://192.168.1.14:5173"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/narration-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*"
}
