@startuml
title Use Case Diagram - Visitor - QR, goi nghe va audio

left to right direction
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor white
  BorderColor black
  FontColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
  FontColor black
}
skinparam ArrowColor black

actor "Visitor" as Visitor

rectangle "KhanhHoi AudioTour Web Public" {
  usecase "UC21\nQuet QR va mo\nquyen truy cap" as UC21
  usecase "UC22\nChon va mua goi\nthuyet minh mo phong" as UC22
  usecase "UC23\nNghe thuyet minh\nva audio bao ve" as UC23
  usecase "Doc noi dung\ngan voi QR" as ReadQr
  usecase "Kiem tra\naccess pass" as CheckPass
  usecase "Tao phien\nthanh toan" as PaymentSession
  usecase "Cap access pass" as IssuePass
  usecase "Phat audio\nbao ve" as PlayAudio
  usecase "Ghi log nghe\nthuyet minh" as LogPlay
  usecase "Bao loi het han\nhoac khong co quyen" as AccessError
}

Visitor --> UC21
Visitor --> UC22
Visitor --> UC23

UC21 ..> ReadQr : <<include>>
UC21 ..> CheckPass : <<include>>
UC22 ..> PaymentSession : <<include>>
UC22 ..> IssuePass : <<include>>
UC22 ..> UC21 : <<extend>>
UC23 ..> CheckPass : <<include>>
UC23 ..> PlayAudio : <<include>>
UC23 ..> LogPlay : <<include>>
UC23 ..> UC21 : <<include>>
AccessError ..> UC21 : <<extend>>
AccessError ..> UC23 : <<extend>>

@enduml
