@startuml
title Use Case Diagram - Vendor - Quan ly noi dung dia diem

left to right direction
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor white
  BorderColor black
  FontColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
  FontColor black
}
skinparam ArrowColor black

actor "Vendor" as Vendor

rectangle "KhanhHoi AudioTour Web Vendor" {
  usecase "UC07\nQuan ly ban dich\nPOI" as UC07
  usecase "UC08\nGui hinh anh\nnoi dung POI" as UC08
  usecase "UC10\nSoan va gui ban\nthuyet minh" as UC10
  usecase "UC01\nDang nhap" as UC01
  usecase "Cap nhat noi dung\nda ngon ngu" as UpdateTranslation
  usecase "Tai hinh anh\nlen thu vien" as UploadImage
  usecase "Gui hinh anh\ncho kiem duyet" as SubmitImage
  usecase "Soan ban nhap\nthuyet minh" as DraftNarration
  usecase "Gui thuyet minh\ncho kiem duyet" as SubmitNarration
  usecase "Kiem tra sap\nthuoc Vendor" as OwnerCheck
}

Vendor --> UC07
Vendor --> UC08
Vendor --> UC10

UC07 ..> UC01 : <<include>>
UC08 ..> UC01 : <<include>>
UC10 ..> UC01 : <<include>>
UC07 ..> OwnerCheck : <<include>>
UC08 ..> OwnerCheck : <<include>>
UC10 ..> OwnerCheck : <<include>>
UC07 ..> UpdateTranslation : <<include>>
UC08 ..> UploadImage : <<include>>
UC08 ..> SubmitImage : <<include>>
UC10 ..> DraftNarration : <<include>>
UC10 ..> SubmitNarration : <<include>>

@enduml
