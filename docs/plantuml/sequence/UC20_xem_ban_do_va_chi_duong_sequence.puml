@startuml
title Sequence Diagram - UC20 Xem ban do va chi duong

actor "Guest" as Guest
participant "MapPage" as MapPage
participant "poisApi" as PoisApi
participant "toursApi" as ToursApi
participant "publicRoutesApi" as PublicRoutesApi
participant "PublicPoisController" as PublicPoisController
participant "PublicToursController" as PublicToursController
participant "PublicRoutesController" as PublicRoutesController
participant "PublicPoiService" as PublicPoiService
participant "TourService" as TourService
participant "PublicRouteService" as PublicRouteService
participant "PoiRepository" as PoiRepository
participant "TourRepository" as TourRepository
entity "Poi" as Poi
entity "Tour" as Tour
entity "TourPoi" as TourPoi

Guest -> MapPage: openMap()
MapPage -> PoisApi: getPaged({ activeOnly: true })
PoisApi -> PublicPoisController: GetPaged(PoiListFilter, languageCode)
PublicPoisController -> PublicPoiService: GetPagedAsync(filter, languageCode, cancellationToken)
PublicPoiService -> PoiRepository: GetPagedAsync(publicFilter)
PoiRepository --> Poi: IReadOnlyList<Poi>

MapPage -> ToursApi: getPaged(filter, lang)
ToursApi -> PublicToursController: GetPaged(TourListFilter, languageCode)
PublicToursController -> TourService: GetPublicPagedAsync(filter, languageCode, cancellationToken)
TourService -> TourRepository: GetPublicPagedAsync(filter)
TourRepository --> Tour: IReadOnlyList<Tour>
Tour --> TourPoi: TourPois

opt Guest chon chi duong POI-to-POI
  MapPage -> PublicRoutesApi: getPoiToPoiRoute(fromPoiId, toPoiId)
  PublicRoutesApi -> PublicRoutesController: GetPoiToPoiRoute(fromPoiId, toPoiId)
  PublicRoutesController -> PublicRouteService: GetPoiToPoiRouteAsync(fromPoiId, toPoiId, cancellationToken)
  PublicRouteService -> PoiRepository: GetByIdAsync(fromPoiId)
  PoiRepository --> Poi: fromPoi
  PublicRouteService -> PoiRepository: GetByIdAsync(toPoiId)
  PoiRepository --> Poi: toPoi
end
@enduml
