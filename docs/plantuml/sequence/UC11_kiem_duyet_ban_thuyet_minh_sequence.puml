@startuml
title Sequence Diagram - UC11 Kiem duyet ban thuyet minh

actor "Admin" as Admin
participant "MediaLibraryPage" as MediaLibraryPage
participant "narrationsApi" as NarrationsApi
participant "NarrationsController" as NarrationsController
participant "NarrationDraftService" as NarrationDraftService
participant "AutoTranslateTtsPipelineService" as AutoTranslateTtsPipelineService
participant "UnitOfWork" as UnitOfWork
entity "NarrationDraft" as NarrationDraft
entity "AudioTrack" as AudioTrack

Admin -> MediaLibraryPage: clickApproveOrReject(id)
alt approve
  MediaLibraryPage -> NarrationsApi: approveNarration(id)
  NarrationsApi -> NarrationsController: Approve(id)
  NarrationsController -> NarrationDraftService: ApproveAsync(id, cancellationToken)
  NarrationDraftService -> NarrationDraft: set Status=Approved
  NarrationDraftService -> AutoTranslateTtsPipelineService: EnqueueAsync(id, cancellationToken)
else reject
  MediaLibraryPage -> NarrationsApi: rejectNarration(id, reason)
  NarrationsApi -> NarrationsController: Reject(id, RejectNarrationDraftRequest)
  NarrationsController -> NarrationDraftService: RejectAsync(id, request, cancellationToken)
  NarrationDraftService -> NarrationDraft: set Status=Rejected
else update text
  MediaLibraryPage -> NarrationsApi: updateText(id, request)
  NarrationsApi -> NarrationsController: UpdateText(id, UpdateNarrationDraftTextRequest)
  NarrationsController -> NarrationDraftService: UpdateTextAsync(id, request, cancellationToken)
  NarrationDraftService -> NarrationDraft: set Content/Title
  NarrationDraftService -> AudioTrack: mark stale when needed
end
NarrationDraftService -> UnitOfWork: SaveChangesAsync(cancellationToken)
NarrationsController --> NarrationsApi: NarrationDraftDto
@enduml
