@startuml
title Sequence Diagram - UC14 Quan ly ma QR gan POI/Tour

actor "Admin" as Admin
participant "QrListPage/QrForm" as QrPage
participant "qrApi" as QrApi
participant "QrController" as QrController
participant "QrService" as QrService
participant "QrRepository" as QrRepository
participant "PoiRepository" as PoiRepository
participant "TourRepository" as TourRepository
participant "SoftDeleteService" as SoftDeleteService
participant "UnitOfWork" as UnitOfWork
entity "QrLocation" as QrLocation
entity "Poi" as Poi
entity "Tour" as Tour
entity "DeletedRecord" as DeletedRecord

Admin -> QrPage: submitQr(request)
QrPage -> QrApi: create(request) / update(id, request)
QrApi -> QrController: Create(CreateQrRequest) / Update(id, UpdateQrRequest)
QrController -> QrService: CreateAsync(request, cancellationToken) / UpdateAsync(id, request, cancellationToken)
opt request.PoiId != null
  QrService -> PoiRepository: GetByIdAsync(request.PoiId)
  PoiRepository --> Poi: Poi
end
opt request.TourId != null
  QrService -> TourRepository: GetByIdAsync(request.TourId)
  TourRepository --> Tour: Tour
end
QrService -> QrRepository: AddAsync(qr) / Update(qr)
QrRepository --> QrLocation: QrLocation
QrService -> UnitOfWork: SaveChangesAsync(cancellationToken)

opt delete
  QrPage -> QrApi: delete(id)
  QrApi -> QrController: Delete(id)
  QrController -> QrService: DeleteAsync(id, cancellationToken)
  QrService -> QrRepository: GetByIdAsync(id)
  QrRepository --> QrLocation: QrLocation
  QrService -> SoftDeleteService: SoftDeleteAsync(qrLocation, ...)
  SoftDeleteService -> DeletedRecord: new DeletedRecord(...)
end
@enduml
