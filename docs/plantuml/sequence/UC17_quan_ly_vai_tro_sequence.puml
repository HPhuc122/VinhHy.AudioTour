@startuml
title Sequence Diagram - UC17 Quan ly vai tro

actor "Admin" as Admin
participant "RolesPage/RoleFormModal" as RolesPage
participant "rolesApi" as RolesApi
participant "RolesController" as RolesController
participant "RoleService" as RoleService
participant "RoleRepository" as RoleRepository
participant "UnitOfWork" as UnitOfWork
entity "Role" as Role

Admin -> RolesPage: useRoles()
RolesPage -> RolesApi: getAll()
RolesApi -> RolesController: GetAll()
RolesController -> RoleService: GetAllAsync(cancellationToken)
RoleService -> RoleRepository: GetAllAsync(cancellationToken)
RoleRepository --> Role: IReadOnlyList<Role>

alt create/update/delete
  RolesPage -> RolesApi: create(data) / update(id, data) / delete(id)
  RolesApi -> RolesController: Create(...) / Update(...) / Delete(...)
  RolesController -> RoleService: CreateAsync(...) / UpdateAsync(...) / DeleteAsync(...)
  RoleService -> RoleRepository: GetByIdAsync(id)
  RoleRepository --> Role: Role?
  RoleService -> RoleRepository: AddAsync(role) / Update(role) / Delete(role)
  RoleService -> UnitOfWork: SaveChangesAsync(cancellationToken)
end
@enduml
