@startuml
title Sequence Diagram - UC16 Quan ly nguoi dung

actor "Admin" as Admin
participant "UsersPage/UserFormModal" as UsersPage
participant "usersApi" as UsersApi
participant "UsersController" as UsersController
participant "UserService" as UserService
participant "UserRepository" as UserRepository
participant "RoleRepository" as RoleRepository
participant "UnitOfWork" as UnitOfWork
entity "User" as User
entity "Role" as Role

Admin -> UsersPage: useUsers(page, pageSize)
UsersPage -> UsersApi: getPaged(page, pageSize)
UsersApi -> UsersController: GetPaged(UserListFilter)
UsersController -> UserService: GetPagedAsync(filter, cancellationToken)
UserService -> UserRepository: GetPagedAsync(filter)
UserRepository --> User: IReadOnlyList<User>

alt create/update/delete
  UsersPage -> UsersApi: create(data) / update(id, data) / delete(id)
  UsersApi -> UsersController: Create(...) / Update(...) / Delete(...)
  UsersController -> UserService: CreateAsync(...) / UpdateAsync(...) / DeleteAsync(...)
  UserService -> RoleRepository: GetByIdAsync(roleId)
  RoleRepository --> Role: Role
  UserService -> UserRepository: GetByIdAsync(id)
  UserRepository --> User: User?
  UserService -> UserRepository: AddAsync(user) / Update(user) / Delete(user)
  UserService -> UnitOfWork: SaveChangesAsync(cancellationToken)
end
@enduml
