@startuml
title Sequence Diagram - UC09 Kiem duyet va quan ly hinh anh

actor "Admin" as Admin
participant "MediaLibraryPage" as MediaLibraryPage
participant "mediaApi" as MediaApi
participant "MediaController" as MediaController
participant "MediaService" as MediaService
participant "MediaRepository" as MediaRepository
participant "SoftDeleteService" as SoftDeleteService
participant "UnitOfWork" as UnitOfWork
entity "MediaFile" as MediaFile
entity "DeletedRecord" as DeletedRecord

Admin -> MediaLibraryPage: clickModerationAction(mediaFileId)
alt approve
  MediaLibraryPage -> MediaApi: approve(id)
  MediaApi -> MediaController: Approve(id)
  MediaController -> MediaService: ApproveAsync(id, cancellationToken)
else reject
  MediaLibraryPage -> MediaApi: reject(id, request)
  MediaApi -> MediaController: Reject(id, RejectMediaRequest)
  MediaController -> MediaService: RejectAsync(id, request, cancellationToken)
else delete
  MediaLibraryPage -> MediaApi: delete(id)
  MediaApi -> MediaController: Delete(id)
  MediaController -> MediaService: DeleteAsync(id, cancellationToken)
else restore
  MediaLibraryPage -> MediaApi: restore(id)
  MediaApi -> MediaController: Restore(id)
  MediaController -> MediaService: RestoreAsync(id, cancellationToken)
end
MediaService -> MediaRepository: GetByIdAsync(id)
MediaRepository --> MediaFile: MediaFile
opt delete
  MediaService -> SoftDeleteService: SoftDeleteAsync(mediaFile, ...)
  SoftDeleteService -> DeletedRecord: new DeletedRecord(...)
end
MediaService -> MediaRepository: Update(mediaFile)
MediaService -> UnitOfWork: SaveChangesAsync(cancellationToken)
MediaController --> MediaApi: MediaFileDto / NoContent()
@enduml
