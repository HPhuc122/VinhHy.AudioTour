@startuml
title Sequence Diagram - UC07 Quan ly ban dich POI

actor "Admin" as Admin
actor "Vendor" as Vendor
participant "PoiTranslationModal" as PoiTranslationModal
participant "poiTranslationsApi" as PoiTranslationsApi
participant "PoiTranslationsController" as PoiTranslationsController
participant "PoiTranslationService" as PoiTranslationService
participant "TranslationProvider" as TranslationProvider
participant "PoiTranslationRepository" as PoiTranslationRepository
participant "PoiRepository" as PoiRepository
participant "LanguageRepository" as LanguageRepository
participant "UnitOfWork" as UnitOfWork
entity "PoiTranslation" as PoiTranslation
entity "Poi" as Poi
entity "Language" as Language

Admin -> PoiTranslationModal: open(poiId)
Vendor -> PoiTranslationModal: open(poiId)
PoiTranslationModal -> PoiTranslationsApi: getByPoiId(poiId)
PoiTranslationsApi -> PoiTranslationsController: GetByPoiId(poiId)
PoiTranslationsController -> PoiTranslationService: GetByPoiIdAsync(poiId, cancellationToken)
PoiTranslationService -> PoiTranslationRepository: GetByPoiIdAsync(poiId)
PoiTranslationRepository --> PoiTranslation: IReadOnlyList<PoiTranslation>

alt create/update
  PoiTranslationModal -> PoiTranslationsApi: create(payload) / update(id, payload)
  PoiTranslationsApi -> PoiTranslationsController: Create(...) / Update(...)
  PoiTranslationsController -> PoiTranslationService: CreateAsync(...) / UpdateAsync(...)
  PoiTranslationService -> PoiRepository: GetByIdAsync(request.PoiId)
  PoiRepository --> Poi: Poi
  PoiTranslationService -> LanguageRepository: GetByCodeAsync(request.LanguageCode)
  LanguageRepository --> Language: Language
  PoiTranslationService -> PoiTranslationRepository: AddAsync(...) / Update(...)
  PoiTranslationService -> UnitOfWork: SaveChangesAsync(cancellationToken)
else generate
  PoiTranslationModal -> PoiTranslationsApi: generate(request)
  PoiTranslationsApi -> PoiTranslationsController: Generate(GeneratePoiTranslationsRequest)
  PoiTranslationsController -> PoiTranslationService: GenerateAsync(request, cancellationToken)
  PoiTranslationService -> TranslationProvider: TranslateAsync(text, source, target, cancellationToken)
  PoiTranslationService -> PoiTranslationRepository: AddAsync(translation, cancellationToken)
  PoiTranslationService -> UnitOfWork: SaveChangesAsync(cancellationToken)
end
@enduml
