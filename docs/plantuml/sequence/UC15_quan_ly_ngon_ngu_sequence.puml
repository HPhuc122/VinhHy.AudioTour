@startuml
title Sequence Diagram - UC15 Quan ly ngon ngu

actor "Admin" as Admin
participant "LanguagePage/LanguageModal" as LanguagePage
participant "languagesApi" as LanguagesApi
participant "LanguagesController" as LanguagesController
participant "LanguageService" as LanguageService
participant "LanguageRepository" as LanguageRepository
participant "UnitOfWork" as UnitOfWork
entity "Language" as Language

Admin -> LanguagePage: useLanguagesQuery()
LanguagePage -> LanguagesApi: getAll(activeOnly)
LanguagesApi -> LanguagesController: GetAll(activeOnly)
LanguagesController -> LanguageService: GetAllAsync(activeOnly, cancellationToken)
LanguageService -> LanguageRepository: GetAllAsync(activeOnly, cancellationToken)
LanguageRepository --> Language: IReadOnlyList<Language>

alt create/update/delete
  Admin -> LanguagePage: submitLanguage(request)
  LanguagePage -> LanguagesApi: create(request) / update(code, request) / delete(code)
  LanguagesApi -> LanguagesController: Create(...) / Update(...) / Delete(...)
  LanguagesController -> LanguageService: CreateAsync(...) / UpdateAsync(...) / DeleteAsync(...)
  LanguageService -> LanguageRepository: GetByCodeAsync(code)
  LanguageRepository --> Language: Language?
  LanguageService -> LanguageRepository: AddAsync(language) / Update(language) / Delete(language)
  LanguageService -> UnitOfWork: SaveChangesAsync(cancellationToken)
end
@enduml
