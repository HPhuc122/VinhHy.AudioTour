@startuml
title Sequence Diagram - UC19 Xem tour va thu tu lo trinh

actor "Guest" as Guest
participant "ToursPage/TourDetailPage/TourRoutePage" as TourPage
participant "toursApi" as ToursApi
participant "PublicToursController" as PublicToursController
participant "TourService" as TourService
participant "TourRepository" as TourRepository
participant "TourPoiRepository" as TourPoiRepository
participant "PublicAudioTourController" as PublicAudioTourController
participant "PublicAudioTourService" as PublicAudioTourService
entity "Tour" as Tour
entity "TourTranslation" as TourTranslation
entity "TourPoi" as TourPoi
entity "Poi" as Poi

Guest -> TourPage: openTours(filterOrId)
alt list
  TourPage -> ToursApi: getPaged(filter, lang)
  ToursApi -> PublicToursController: GetPaged(TourListFilter, languageCode)
  PublicToursController -> TourService: GetPublicPagedAsync(filter, languageCode, cancellationToken)
  TourService -> TourRepository: GetPublicPagedAsync(filter)
  TourRepository --> Tour: IReadOnlyList<Tour>
else detail
  TourPage -> ToursApi: getById(id, lang)
  ToursApi -> PublicToursController: GetById(id, languageCode)
  PublicToursController -> TourService: GetPublicByIdAsync(id, languageCode, cancellationToken)
  TourService -> TourRepository: GetByIdAsync(id)
  TourRepository --> Tour: Tour
  Tour -> TourTranslation: Translations
  Tour -> TourPoi: TourPois
  TourPoi -> Poi: Poi
else protected audio tour
  TourPage -> ToursApi: getAudioTour(tourId, accessToken)
  ToursApi -> PublicAudioTourController: GetTour(tourId, languageCode)
  PublicAudioTourController -> PublicAudioTourService: GetTourAsync(tourId, languageCode, accessToken, cancellationToken)
  PublicAudioTourService -> TourRepository: GetByIdAsync(tourId)
  TourRepository --> Tour: Tour
end
@enduml
