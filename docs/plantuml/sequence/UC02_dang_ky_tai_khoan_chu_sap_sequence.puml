@startuml
title Sequence Diagram - UC02 Dang ky tai khoan Vendor

actor "Vendor" as Vendor
participant "VendorRegisterPage" as VendorRegisterPage
participant "authApi" as AuthApi
participant "AuthController" as AuthController
participant "AuthService" as AuthService
participant "UserRepository" as UserRepository
participant "RoleRepository" as RoleRepository
participant "UnitOfWork" as UnitOfWork
entity "User" as User
entity "Role" as Role

Vendor -> VendorRegisterPage: onSubmit(registerForm)
VendorRegisterPage -> AuthApi: registerVendor(payload)
AuthApi -> AuthController: Register(RegisterRequest)
AuthController -> AuthService: RegisterAsync(request, cancellationToken)
AuthService -> UserRepository: GetByUsernameAsync(request.Username)
UserRepository --> AuthService: User?
AuthService -> UserRepository: GetByEmailAsync(request.Email)
UserRepository --> AuthService: User?
AuthService -> RoleRepository: GetByNameAsync("Vendor")
RoleRepository --> Role: Role
alt username/email chua ton tai va Role ton tai
  AuthService -> User: new User(...)
  AuthService -> UserRepository: AddAsync(user, cancellationToken)
  AuthService -> UnitOfWork: SaveChangesAsync(cancellationToken)
  AuthController --> AuthApi: NoContent()
  AuthApi --> VendorRegisterPage: void
else trung username/email hoac thieu Role
  AuthController --> AuthApi: BadRequest()
  AuthApi --> VendorRegisterPage: ApiError
end
@enduml
