@startuml
title Sequence Diagram - UC05 Duyet va quyet dinh vong doi POI

actor "Admin" as Admin
participant "PoiTable" as PoiTable
participant "poisApi" as PoisApi
participant "PoisController" as PoisController
participant "PoiService" as PoiService
participant "PoiRepository" as PoiRepository
participant "UnitOfWork" as UnitOfWork
entity "Poi" as Poi
entity "PoiPaymentSession" as PoiPaymentSession

Admin -> PoiTable: clickApprovalAction(id)
alt approve review
  PoiTable -> PoisApi: approveReview(id)
  PoisApi -> PoisController: ApproveReview(id)
  PoisController -> PoiService: ApproveReviewAsync(id, cancellationToken)
else request payment
  PoiTable -> PoisApi: requestPayment(id)
  PoisApi -> PoisController: RequestPayment(id)
  PoisController -> PoiService: RequestPaymentAsync(id, cancellationToken)
else reject
  PoiTable -> PoisApi: reject(id)
  PoisApi -> PoisController: Reject(id)
  PoisController -> PoiService: RejectAsync(id, cancellationToken)
else mark paid
  PoiTable -> PoisApi: markPaid(id)
  PoisApi -> PoisController: MarkPaid(id)
  PoisController -> PoiService: MarkPaidAsync(id, cancellationToken)
else waive payment
  PoiTable -> PoisApi: waivePayment(id)
  PoisApi -> PoisController: WaivePayment(id)
  PoisController -> PoiService: WaivePaymentAsync(id, cancellationToken)
end
PoiService -> PoiRepository: GetByIdAsync(id)
PoiRepository --> Poi: Poi
PoiService -> Poi: set LifecycleStatus/PaymentStatus
opt tao phien thanh toan
  PoiService -> PoiPaymentSession: new PoiPaymentSession(...)
end
PoiService -> PoiRepository: Update(poi)
PoiService -> UnitOfWork: SaveChangesAsync(cancellationToken)
PoisController --> PoisApi: PoiDto
PoisApi --> PoiTable: PoiDto
@enduml
