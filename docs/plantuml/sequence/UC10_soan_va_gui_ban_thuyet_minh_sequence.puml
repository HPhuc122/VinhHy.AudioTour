@startuml
title Sequence Diagram - UC10 Soan va gui ban thuyet minh

actor "Vendor" as Vendor
participant "MediaLibraryPage" as MediaLibraryPage
participant "narrationsApi" as NarrationsApi
participant "NarrationsController" as NarrationsController
participant "NarrationDraftService" as NarrationDraftService
participant "PoiRepository" as PoiRepository
participant "LanguageRepository" as LanguageRepository
participant "UnitOfWork" as UnitOfWork
entity "NarrationDraft" as NarrationDraft
entity "Poi" as Poi
entity "Language" as Language

Vendor -> MediaLibraryPage: submitDraft(CreateNarrationDraftRequest)
MediaLibraryPage -> NarrationsApi: createNarration(request)
NarrationsApi -> NarrationsController: Create(CreateNarrationDraftRequest)
NarrationsController -> NarrationDraftService: CreateAsync(request, currentUserId, isVendor, cancellationToken)
NarrationDraftService -> PoiRepository: GetByIdAsync(request.PoiId)
PoiRepository --> Poi: Poi
NarrationDraftService -> LanguageRepository: GetByCodeAsync(request.LanguageCode)
LanguageRepository --> Language: Language
NarrationDraftService -> NarrationDraft: new NarrationDraft(...)
NarrationDraftService -> UnitOfWork: SaveChangesAsync(cancellationToken)
NarrationsController --> NarrationsApi: NarrationDraftDto
NarrationsApi --> MediaLibraryPage: NarrationDraftDto
@enduml
