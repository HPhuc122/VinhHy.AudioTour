@startuml
title Sequence Diagram - UC22 Chon va mua goi thuyet minh mo phong

actor "Guest" as Guest
participant "PackagesPage" as PackagesPage
participant "publicPackagesApi" as PublicPackagesApi
participant "publicAccessApi" as PublicAccessApi
participant "PublicPackagesController" as PublicPackagesController
participant "QrService" as QrService
participant "PublicAccessController" as PublicAccessController
participant "PublicAccessService" as PublicAccessService
participant "QrRepository" as QrRepository
participant "AccessPaymentSessionRepository" as AccessPaymentSessionRepository
participant "GuestAccessPassRepository" as GuestAccessPassRepository
entity "QrLocation" as QrLocation
entity "AccessPaymentSession" as AccessPaymentSession
entity "GuestAccessPass" as GuestAccessPass

Guest -> PackagesPage: openPackages()
PackagesPage -> PublicPackagesApi: getPackages()
PublicPackagesApi -> PublicPackagesController: GetPackages()
PublicPackagesController -> QrService: GetPublicPackagesAsync(cancellationToken)
QrService -> QrRepository: GetActiveServiceLevelAsync(cancellationToken)
QrRepository --> QrLocation: IReadOnlyList<QrLocation>

Guest -> PackagesPage: buy(pkg.code)
PackagesPage -> PublicAccessApi: start(pkg.code)
PublicAccessApi -> PublicAccessController: Start(StartAccessRequest)
PublicAccessController -> PublicAccessService: StartAsync(request, cancellationToken)
PublicAccessService -> QrRepository: GetByCodeAsync(request.QrCode)
QrRepository --> QrLocation: QrLocation
PublicAccessService -> GuestAccessPassRepository: AddAsync(pass, cancellationToken)
PublicAccessService -> AccessPaymentSessionRepository: AddAsync(session, cancellationToken)
AccessPaymentSessionRepository --> AccessPaymentSession: AccessPaymentSession

PackagesPage -> PublicAccessApi: simulatePayment(paymentSessionId, true)
PublicAccessApi -> PublicAccessController: SimulatePayment(SimulatePaymentRequest)
PublicAccessController -> PublicAccessService: SimulatePaymentAsync(request, cancellationToken)
PublicAccessService -> AccessPaymentSessionRepository: GetByIdAsync(request.PaymentSessionId)
AccessPaymentSessionRepository --> AccessPaymentSession: AccessPaymentSession
PublicAccessService -> GuestAccessPassRepository: Update(pass)
GuestAccessPassRepository --> GuestAccessPass: GuestAccessPass
@enduml
