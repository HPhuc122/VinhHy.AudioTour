@startuml
title Sequence Diagram - UC18 Kham pha va tim kiem POI cong khai

actor "Guest" as Guest
participant "HomePage/PoisPage/SearchPage/PoiDetailPage" as PublicPoiPage
participant "poisApi" as PoisApi
participant "PublicPoisController" as PublicPoisController
participant "PublicPoiService" as PublicPoiService
participant "PoiRepository" as PoiRepository
participant "MediaRepository" as MediaRepository
entity "Poi" as Poi
entity "PoiTranslation" as PoiTranslation
entity "MediaFile" as MediaFile

Guest -> PublicPoiPage: search/openPoi(filterOrId)
alt list/search
  PublicPoiPage -> PoisApi: getPaged(filter, lang)
  PoisApi -> PublicPoisController: GetPaged(PoiListFilter, languageCode)
  PublicPoisController -> PublicPoiService: GetPagedAsync(filter, languageCode, cancellationToken)
  PublicPoiService -> PoiRepository: GetPagedAsync(publicFilter)
  PoiRepository --> Poi: IReadOnlyList<Poi>
else detail
  PublicPoiPage -> PoisApi: getById(id, lang)
  PoisApi -> PublicPoisController: GetById(id, languageCode)
  PublicPoisController -> PublicPoiService: GetByIdAsync(id, languageCode, cancellationToken)
  PublicPoiService -> PoiRepository: GetByIdAsync(id)
  PoiRepository --> Poi: Poi
end
Poi --> PoiTranslation: Translations
PublicPoiService -> MediaRepository: GetApprovedImagesByPoiIdsAsync(poiIds)
MediaRepository --> MediaFile: IReadOnlyList<MediaFile>
PublicPoisController --> PoisApi: PublicPoiDto / PagedResult<PublicPoiDto>
PoisApi --> PublicPoiPage: mapped POI data
@enduml
