@startuml
title Sequence Diagram - UC04 Quan ly POI va dang ky sap

actor "Admin" as Admin
actor "Vendor" as Vendor
participant "PoiPage" as PoiPage
participant "PoiFormModal" as PoiFormModal
participant "poisApi" as PoisApi
participant "PoisController" as PoisController
participant "PoiService" as PoiService
participant "FileUploadService" as FileUploadService
participant "PoiRepository" as PoiRepository
participant "UserRepository" as UserRepository
participant "UnitOfWork" as UnitOfWork
entity "Poi" as Poi
entity "User" as User

Admin -> PoiPage: usePoisQuery(filter)
Vendor -> PoiPage: usePoisQuery(filter)
PoiPage -> PoisApi: getPaged(filter)
PoisApi -> PoisController: GetPaged(PoiListFilter)
PoisController -> PoiService: GetPagedAsync(filter, currentUserId, isVendor, cancellationToken)
PoiService -> PoiRepository: GetPagedAsync(filter)
PoiRepository --> Poi: IReadOnlyList<Poi>
PoisController --> PoisApi: PagedResult<PoiDto>

alt create
  Vendor -> PoiFormModal: submit(CreatePoiRequest)
  Admin -> PoiFormModal: submit(CreatePoiRequest)
  PoiFormModal -> PoisApi: create(formData)
  PoisApi -> PoisController: Create(CreatePoiRequest)
  PoisController -> PoiService: CreateAsync(request, currentUserId, isVendor, cancellationToken)
  PoiService -> UserRepository: GetByIdAsync(ownerUserId)
  UserRepository --> User: User
  opt request.ImageFile != null
    PoiService -> FileUploadService: SaveFileAsync(file, "uploads/pois", cancellationToken)
  end
  PoiService -> Poi: new Poi(...)
  PoiService -> PoiRepository: AddAsync(poi, cancellationToken)
  PoiService -> UnitOfWork: SaveChangesAsync(cancellationToken)
  PoisController --> PoisApi: PoiDto
else update
  PoiFormModal -> PoisApi: update(id, formData)
  PoisApi -> PoisController: Update(id, UpdatePoiRequest)
  PoisController -> PoiService: UpdateAsync(id, request, currentUserId, isVendor, cancellationToken)
  PoiService -> PoiRepository: GetByIdAsync(id)
  PoiRepository --> Poi: Poi
  PoiService -> PoiRepository: Update(poi)
  PoiService -> UnitOfWork: SaveChangesAsync(cancellationToken)
  PoisController --> PoisApi: PoiDto
end
@enduml
