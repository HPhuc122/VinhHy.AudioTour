@startuml
title Sequence Diagram - UC13 Quan ly tour, ban dich va thu tu diem dung

actor "Admin" as Admin
participant "TourListPage/TourEditPage" as TourPage
participant "tourApi" as TourApi
participant "ToursController" as ToursController
participant "TourService" as TourService
participant "TourRepository" as TourRepository
participant "TourTranslationRepository" as TourTranslationRepository
participant "TourPoiRepository" as TourPoiRepository
participant "PoiRepository" as PoiRepository
participant "UnitOfWork" as UnitOfWork
entity "Tour" as Tour
entity "TourTranslation" as TourTranslation
entity "TourPoi" as TourPoi
entity "Poi" as Poi

Admin -> TourPage: submitTour(request)
TourPage -> TourApi: create(request) / update(id, request)
TourApi -> ToursController: Create(...) / Update(...)
ToursController -> TourService: CreateAsync(...) / UpdateAsync(...)
TourService -> TourRepository: AddAsync(tour) / Update(tour)
TourService -> UnitOfWork: SaveChangesAsync(cancellationToken)

alt translation
  TourPage -> TourApi: addTranslation(tourId, request) / updateTranslation(id, request)
  TourApi -> ToursController: AddTranslation(...) / UpdateTranslation(...)
  ToursController -> TourService: AddTranslationAsync(...) / UpdateTranslationAsync(...)
  TourService -> TourRepository: GetByIdAsync(tourId)
  TourRepository --> Tour: Tour
  TourService -> TourTranslationRepository: AddAsync(...) / Update(...)
  TourTranslationRepository --> TourTranslation: TourTranslation
else route order
  TourPage -> TourApi: addPoi(tourId, request) / reorderPois(tourId, request)
  TourApi -> ToursController: AddPoi(...) / ReorderPois(...)
  ToursController -> TourService: AddPoiAsync(...) / ReorderPoisAsync(...)
  TourService -> PoiRepository: GetByIdAsync(poiId)
  PoiRepository --> Poi: Poi
  TourService -> TourPoiRepository: AddAsync(...) / Update(...)
  TourPoiRepository --> TourPoi: TourPoi
end
TourService -> UnitOfWork: SaveChangesAsync(cancellationToken)
@enduml
