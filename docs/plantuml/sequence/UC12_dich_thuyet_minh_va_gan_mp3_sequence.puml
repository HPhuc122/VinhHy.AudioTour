@startuml
title Sequence Diagram - UC12 Dich thuyet minh va gan MP3

actor "Admin" as Admin
participant "MediaLibraryPage" as MediaLibraryPage
participant "CmsAudioPreviewPlayer" as CmsAudioPreviewPlayer
participant "narrationsApi" as NarrationsApi
participant "cmsAudioPreviewApi" as CmsAudioPreviewApi
participant "NarrationsController" as NarrationsController
participant "CmsAudioPreviewController" as CmsAudioPreviewController
participant "NarrationDraftService" as NarrationDraftService
participant "TranslationProvider" as TranslationProvider
participant "GoogleTtsService" as GoogleTtsService
participant "AudioTrackRepository" as AudioTrackRepository
participant "ApplicationDbContext" as ApplicationDbContext
participant "UnitOfWork" as UnitOfWork
entity "NarrationDraft" as NarrationDraft
entity "AudioTrack" as AudioTrack

Admin -> MediaLibraryPage: clickGenerateTranslations(sourceDraftId)
MediaLibraryPage -> NarrationsApi: generateTranslations(sourceDraftId, request)
NarrationsApi -> NarrationsController: GenerateTranslations(id, GenerateNarrationTranslationsRequest)
NarrationsController -> NarrationDraftService: GenerateTranslationsAsync(id, request, cancellationToken)
NarrationDraftService -> TranslationProvider: TranslateAsync(text, source, target, cancellationToken)
NarrationDraftService -> NarrationDraft: new translated NarrationDraft(...)
NarrationDraftService -> UnitOfWork: SaveChangesAsync(cancellationToken)

Admin -> MediaLibraryPage: clickGenerateAudio(draftId)
MediaLibraryPage -> NarrationsApi: generateAudio(draftId)
NarrationsApi -> NarrationsController: GenerateAudio(id)
NarrationsController -> NarrationDraftService: GenerateAudioAsync(id, cancellationToken)
NarrationDraftService -> GoogleTtsService: SynthesizeAsync(text, languageCode, cancellationToken)
NarrationDraftService -> AudioTrackRepository: GetByPoiAndLanguageAsync(poiId, languageCode)
AudioTrackRepository --> AudioTrack: AudioTrack?
NarrationDraftService -> AudioTrackRepository: AddAsync(track) / Update(track)
NarrationDraftService -> UnitOfWork: SaveChangesAsync(cancellationToken)

Admin -> CmsAudioPreviewPlayer: loadPreview(poiId)
CmsAudioPreviewPlayer -> CmsAudioPreviewApi: getByPoi(poiId)
CmsAudioPreviewApi -> CmsAudioPreviewController: GetByPoi(poiId)
CmsAudioPreviewController -> ApplicationDbContext: AudioTracks.AsNoTracking().WhereByPoiAndActive(poiId)
ApplicationDbContext --> AudioTrack: IReadOnlyList<AudioTrack>
CmsAudioPreviewPlayer -> CmsAudioPreviewApi: stream(audioTrackId)
CmsAudioPreviewApi -> CmsAudioPreviewController: Stream(audioTrackId)
CmsAudioPreviewController -> ApplicationDbContext: AudioTracks.FirstOrDefaultAsync(audioTrackId)
ApplicationDbContext --> AudioTrack: AudioTrack
@enduml
