@startuml
title Sequence Diagram - UC01 Dang nhap va duy tri phien

actor "Nhan vien CMS" as Actor
participant "Presentation Layer\nWebAdminUI - LoginPage va AuthProvider" as UI
participant "Business Logic Layer\nAuthController + AuthService + JwtTokenService" as Business
participant "Data Access Layer\nUserRepository + RoleRepository + DbContext" as DataAccess
database "Database" as Database

Actor -> UI: Nhap ten dang nhap va mat khau
UI -> UI: Kiem tra thong tin bat buoc
UI -> Business: Gui yeu cau dang nhap
Business -> DataAccess: Tim user kem vai tro
DataAccess -> Database: Doc du lieu user va role
Database --> DataAccess: Tra thong tin tai khoan
DataAccess --> Business: Tra user
alt Tai khoan ton tai, active va mat khau dung
  Business -> Business: Tao access token va refresh token
  Business -> DataAccess: Luu refresh token va han dung
  DataAccess -> Database: Ghi thay doi user
  Database --> DataAccess: Xac nhan
  DataAccess --> Business: Hoan tat
  Business --> UI: Tra phien va vai tro
  UI --> Actor: Chuyen vao dashboard
else Sai thong tin hoac tai khoan bi khoa
  Business --> UI: Tra loi khong duoc xac thuc
  UI --> Actor: Hien thi loi dang nhap
end

opt Access token het han
  UI -> Business: Gui refresh token
  Business -> DataAccess: Tim user theo refresh token
  DataAccess -> Database: Doc token va han dung
  Database --> DataAccess: Tra ket qua
  DataAccess --> Business: Tra user hoac khong tim thay
  alt Refresh token con hop le
    Business -> Business: Phat cap token moi
    Business -> DataAccess: Cap nhat refresh token moi
    DataAccess -> Database: Ghi thay doi
    Database --> DataAccess: Xac nhan
    Business --> UI: Tra phien moi
  else Token sai, het han hoac user inactive
    Business --> UI: Tra loi phien het han
    UI --> Actor: Xoa phien va yeu cau dang nhap lai
  end
end
@enduml
