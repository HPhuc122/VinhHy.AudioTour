@startuml
title Sequence Diagram - UC01 Dang nhap va duy tri phien

actor "Admin" as Admin
actor "Vendor" as Vendor
participant "LoginPage" as LoginPage
participant "AuthProvider" as AuthProvider
participant "authApi" as AuthApi
participant "AuthController" as AuthController
participant "AuthService" as AuthService
participant "JwtTokenService" as JwtTokenService
participant "UserRepository" as UserRepository
entity "User" as User
entity "Role" as Role

Admin -> LoginPage: submit(credentials)
Vendor -> LoginPage: submit(credentials)
LoginPage -> AuthProvider: login(credentials)
AuthProvider -> AuthApi: login(credentials)
AuthApi -> AuthController: Login(LoginRequest)
AuthController -> AuthService: LoginAsync(request, cancellationToken)
AuthService -> UserRepository: GetByUsernameAsync(request.Username)
UserRepository --> User: User
User --> Role: Role
alt User.IsActive && password hop le
  AuthService -> JwtTokenService: GenerateAccessToken(user)
  AuthService -> JwtTokenService: GenerateRefreshToken()
  AuthService -> UserRepository: Update(user)
  AuthController --> AuthApi: LoginResponse
  AuthApi --> AuthProvider: LoginResponseDto
  AuthProvider --> LoginPage: AuthSession
else user null hoac password sai
  AuthController --> AuthApi: Unauthorized()
  AuthApi --> LoginPage: ApiError
end

opt access token het han
  AuthProvider -> AuthApi: refresh(refreshToken)
  AuthApi -> AuthController: Refresh(RefreshTokenRequest)
  AuthController -> AuthService: RefreshTokenAsync(request, cancellationToken)
  AuthService -> UserRepository: GetByRefreshTokenAsync(request.RefreshToken)
  UserRepository --> User: User
  AuthService -> JwtTokenService: GenerateAccessToken(user)
  AuthService -> JwtTokenService: GenerateRefreshToken()
  AuthService -> UserRepository: Update(user)
  AuthController --> AuthApi: LoginResponse
end
@enduml
