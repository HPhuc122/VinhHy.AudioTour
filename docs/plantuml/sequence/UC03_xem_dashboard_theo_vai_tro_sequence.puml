@startuml
title Sequence Diagram - UC03 Xem dashboard theo vai tro

actor "Admin" as Admin
actor "Vendor" as Vendor
participant "DashboardPage" as DashboardPage
participant "analyticsApi" as AnalyticsApi
participant "poisApi" as PoisApi
participant "AnalyticsController" as AnalyticsController
participant "AnalyticsService" as AnalyticsService
participant "AnalyticsRepository" as AnalyticsRepository
participant "PoisController" as PoisController
participant "PoiService" as PoiService
participant "PoiRepository" as PoiRepository
entity "AnalyticsDaily" as AnalyticsDaily
entity "Poi" as Poi

Admin -> DashboardPage: useDashboardStatsQuery()
Vendor -> DashboardPage: useDashboardStatsQuery()
DashboardPage -> AnalyticsApi: getDashboard()
AnalyticsApi -> AnalyticsController: GetDashboard()
AnalyticsController -> AnalyticsService: GetDashboardAsync(cancellationToken)
AnalyticsService -> AnalyticsRepository: GetByDateRangeAsync(from, to)
AnalyticsRepository --> AnalyticsDaily: IReadOnlyList<AnalyticsDaily>
AnalyticsService -> PoiRepository: GetPagedAsync(filter)
PoiRepository --> Poi: IReadOnlyList<Poi>
AnalyticsController --> AnalyticsApi: DashboardStatsDto
AnalyticsApi --> DashboardPage: DashboardStatsDto

alt Admin xem ban do POI
  DashboardPage -> PoisApi: getPaged({ pageSize: 500 })
  PoisApi -> PoisController: GetPaged(PoiListFilter)
  PoisController -> PoiService: GetPagedAsync(filter, cancellationToken)
  PoiService -> PoiRepository: GetPagedAsync(filter)
  PoiRepository --> Poi: IReadOnlyList<Poi>
  PoisController --> PoisApi: PagedResult<PoiDto>
else Vendor xem POI cua minh
  DashboardPage -> PoisApi: getPaged({ ownerUserId })
  PoisApi -> PoisController: GetPaged(PoiListFilter)
  PoisController -> PoiService: GetPagedAsync(filter, currentUserId, isVendor, cancellationToken)
  PoiService -> PoiRepository: GetPagedAsync(filter)
  PoiRepository --> Poi: IReadOnlyList<Poi>
  PoisController --> PoisApi: PagedResult<PoiDto>
end
@enduml
