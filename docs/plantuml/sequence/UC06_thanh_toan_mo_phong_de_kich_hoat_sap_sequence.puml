@startuml
title Sequence Diagram - UC06 Thanh toan mo phong de kich hoat sap

actor "Vendor" as Vendor
participant "VendorDashboard" as VendorDashboard
participant "poisApi" as PoisApi
participant "PoisController" as PoisController
participant "PoiService" as PoiService
participant "PoiRepository" as PoiRepository
participant "UnitOfWork" as UnitOfWork
entity "Poi" as Poi
entity "PoiPaymentSession" as PoiPaymentSession

Vendor -> VendorDashboard: clickStartPayment(poiId)
VendorDashboard -> PoisApi: startPayment(poiId)
PoisApi -> PoisController: StartPayment(id)
PoisController -> PoiService: StartPaymentAsync(id, currentUserId, cancellationToken)
PoiService -> PoiRepository: GetByIdAsync(id)
PoiRepository --> Poi: Poi
PoiService -> PoiPaymentSession: new PoiPaymentSession(...)
PoiService -> PoiRepository: Update(poi)
PoiService -> UnitOfWork: SaveChangesAsync(cancellationToken)
PoisController --> PoisApi: StartPoiPaymentResponse

Vendor -> VendorDashboard: confirmSimulatedMomo(sessionId)
VendorDashboard -> PoisApi: simulateMomoPayment(poiId, request)
PoisApi -> PoisController: SimulateMomoPayment(id, SimulatePoiPaymentRequest)
PoisController -> PoiService: SimulateMomoPaymentAsync(id, request, currentUserId, cancellationToken)
PoiService -> PoiRepository: GetByIdAsync(id)
PoiRepository --> Poi: Poi
Poi --> PoiPaymentSession: PaymentSessions
alt session hop le && request.Success
  PoiService -> Poi: set Paid/Active
else session het han hoac failed
  PoiService -> Poi: set PaymentFailed/Expired
end
PoiService -> PoiRepository: Update(poi)
PoiService -> UnitOfWork: SaveChangesAsync(cancellationToken)
PoisController --> PoisApi: SimulatePoiPaymentResponse
@enduml
