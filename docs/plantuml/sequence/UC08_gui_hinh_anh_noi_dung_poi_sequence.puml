@startuml
title Sequence Diagram - UC08 Gui hinh anh noi dung POI

actor "Vendor" as Vendor
participant "MediaLibraryPage" as MediaLibraryPage
participant "mediaApi" as MediaApi
participant "MediaController" as MediaController
participant "MediaService" as MediaService
participant "FileUploadService" as FileUploadService
participant "MediaRepository" as MediaRepository
participant "PoiRepository" as PoiRepository
participant "UnitOfWork" as UnitOfWork
entity "MediaFile" as MediaFile
entity "Poi" as Poi

Vendor -> MediaLibraryPage: submitUpload(formData)
MediaLibraryPage -> MediaApi: upload(formData)
MediaApi -> MediaController: Upload(UploadMediaRequest)
MediaController -> MediaService: UploadAsync(request, currentUserId, isVendor, cancellationToken)
MediaService -> PoiRepository: GetByIdAsync(request.PoiId)
PoiRepository --> Poi: Poi
MediaService -> FileUploadService: SaveFileAsync(file, uploadDirectory, cancellationToken)
MediaService -> MediaFile: new MediaFile(...)
MediaService -> MediaRepository: AddAsync(mediaFile, cancellationToken)
MediaService -> UnitOfWork: SaveChangesAsync(cancellationToken)
MediaController --> MediaApi: MediaFileDto
MediaApi --> MediaLibraryPage: MediaFileDto
@enduml
