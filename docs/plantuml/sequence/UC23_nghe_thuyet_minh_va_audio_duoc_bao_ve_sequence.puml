@startuml
title Sequence Diagram - UC23 Nghe thuyet minh va audio duoc bao ve

actor "Guest" as Guest
participant "ProtectedAudioPlayer" as ProtectedAudioPlayer
participant "publicAudioTourApi" as PublicAudioTourApi
participant "PublicAudioTourController" as PublicAudioTourController
participant "PublicAudioTourService" as PublicAudioTourService
participant "PublicAudioController" as PublicAudioController
participant "PublicAccessService" as PublicAccessService
participant "GuestAccessPassRepository" as GuestAccessPassRepository
participant "AudioTrackRepository" as AudioTrackRepository
participant "NarrationLogRepository" as NarrationLogRepository
participant "UnitOfWork" as UnitOfWork
entity "GuestAccessPass" as GuestAccessPass
entity "AudioTrack" as AudioTrack
entity "NarrationLog" as NarrationLog

Guest -> ProtectedAudioPlayer: play(audioTrackId)
ProtectedAudioPlayer -> PublicAudioTourApi: getAudioBlob(audioTrackId, accessToken)
PublicAudioTourApi -> PublicAudioController: Stream(audioTrackId)
PublicAudioController -> PublicAccessService: ValidateAccessForAudioTrackAsync(accessToken, audioTrackId, cancellationToken)
PublicAccessService -> GuestAccessPassRepository: GetByTokenHashAsync(tokenHash)
GuestAccessPassRepository --> GuestAccessPass: GuestAccessPass
PublicAccessService -> AudioTrackRepository: GetByIdAsync(audioTrackId)
AudioTrackRepository --> AudioTrack: AudioTrack
alt access hop le
  PublicAudioController --> PublicAudioTourApi: FileStreamResult
  PublicAudioTourApi --> ProtectedAudioPlayer: Blob
else access het han hoac sai target
  PublicAudioController --> PublicAudioTourApi: Forbid()/Unauthorized()
end

opt record play
  ProtectedAudioPlayer -> PublicAudioTourApi: recordAudioPlay(audioTrackId, accessToken, languageCode, triggerType)
  PublicAudioTourApi -> PublicAudioController: RecordPlay(audioTrackId, languageCode, triggerType)
  PublicAudioController -> PublicAccessService: ValidateAccessForAudioTrackAsync(accessToken, audioTrackId, cancellationToken)
  PublicAudioController -> AudioTrackRepository: GetByIdAsync(audioTrackId)
  AudioTrackRepository --> AudioTrack: AudioTrack
  PublicAudioController -> NarrationLog: new NarrationLog(...)
  PublicAudioController -> NarrationLogRepository: AddAsync(log, cancellationToken)
  PublicAudioController -> UnitOfWork: SaveChangesAsync(cancellationToken)
end
@enduml
